{
  "$defs": {
    "Calibration": {
      "additionalProperties": false,
      "description": "Independent reference population, rollout and calibration budget settings.",
      "properties": {
        "reference_window": {
          "default": 16,
          "minimum": 1,
          "title": "Reference Window",
          "type": "integer"
        },
        "candidates": {
          "default": 8,
          "minimum": 1,
          "title": "Candidates",
          "type": "integer"
        },
        "trials": {
          "default": 4,
          "minimum": 1,
          "title": "Trials",
          "type": "integer"
        },
        "action_cap": {
          "default": 16,
          "minimum": 1,
          "title": "Action Cap",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        }
      },
      "title": "Calibration",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "description": "Per-run request, token and time ceilings, including logical cache use.",
      "properties": {
        "max_requests": {
          "default": 128,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_input_tokens": {
          "default": 16000,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_total_input_tokens": {
          "default": 1000000,
          "minimum": 1,
          "title": "Max Total Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 16384,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "PromptSettings": {
      "additionalProperties": false,
      "description": "Frozen component instructions, saved with each experiment condition.",
      "properties": {
        "policy": {
          "default": "Sokoban: # wall, - floor, . goal, $ box, * box on goal, @ player,\n+ player on goal. Move UP, DOWN, LEFT or RIGHT. You may push one box into a free\ncell, never pull or push two boxes. Solve by putting every box on a goal.\nPreserve walls, goals, box count and one player. Return only the requested JSON.\nReturn a probability vector in action order [UP, DOWN, LEFT, RIGHT]\nfor the NEXT SINGLE primitive action towards the supplied subgoal. Use nonnegative\nprobabilities with positive sum. This same policy is sampled during calibration\nand search. The subgoal is an explicit board; do not invent a multi-action move.",
          "minLength": 1,
          "title": "Policy",
          "type": "string"
        },
        "value": {
          "default": "Sokoban: # wall, - floor, . goal, $ box, * box on goal, @ player,\n+ player on goal. Move UP, DOWN, LEFT or RIGHT. You may push one box into a free\ncell, never pull or push two boxes. Solve by putting every box on a goal.\nPreserve walls, goals, box count and one player. Return only the requested JSON.\nEstimate value in [0,1]: the discounted continuation return for\nsolving this board. The examples use discount ** remaining_solution_actions.\nHigher is closer to solving; a solved board has value 1.",
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "value_remaining": {
          "default": "Sokoban: # wall, - floor, . goal, $ box, * box on goal, @ player, + player on goal. Estimate the number of remaining single player moves (including pushes) until all boxes are on goals. Examples are verified training trajectories, not necessarily optimal. Return 0 for a solved state. Use the board and the demonstrations to estimate remaining moves; output only the requested JSON.",
          "minLength": 1,
          "title": "Value Remaining",
          "type": "string"
        },
        "generator": {
          "default": "Sokoban: # wall, - floor, . goal, $ box, * box on goal, @ player,\n+ player on goal. Move UP, DOWN, LEFT or RIGHT. You may push one box into a free\ncell, never pull or push two boxes. Solve by putting every box on a goal.\nPreserve walls, goals, box count and one player. Return only the requested JSON.\nPropose distinct intermediate subgoal boards, different from the input.",
          "minLength": 1,
          "title": "Generator",
          "type": "string"
        },
        "fixed": {
          "default": "k is a FIXED number of primitive moves along a successful trajectory. Propose a useful state k moves ahead, reachable within k actions when cap=k. The examples are verified k-action transitions. k never denotes a percentile.",
          "minLength": 1,
          "title": "Fixed",
          "type": "string"
        },
        "relative": {
          "default": "u is a policy-relative percentile, NOT a number of moves or a success probability. For each training context, targets were weighted by the frozen policy's exact-hit rates and ranked by mean successful first-hit time. Ties share the midpoint of their combined percentile interval. Infer this scale from examples without reconstructing a reference distribution for the query. The controller has a separate fixed action cap L.",
          "minLength": 1,
          "title": "Relative",
          "type": "string"
        },
        "absolute": {
          "default": "d is the frozen policy's mean successful first-hit execution time in primitive actions, measured by repeated rollouts. It is not necessarily the trajectory offset. The controller has a separate fixed action cap L.",
          "minLength": 1,
          "title": "Absolute",
          "type": "string"
        }
      },
      "title": "PromptSettings",
      "type": "object"
    },
    "Tuning": {
      "additionalProperties": false,
      "description": "Equal-size validation grids for the two main comparison conditions.",
      "properties": {
        "relative_scales": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Relative Scales",
          "type": "array"
        },
        "fixed_scales": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Fixed Scales",
          "type": "array"
        }
      },
      "title": "Tuning",
      "type": "object"
    }
  },
  "additionalProperties": false,
