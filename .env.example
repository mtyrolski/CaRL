# Copy to .env; the experiment CLI loads it without overriding exported variables.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional OpenAI project/organisation selection:
# OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=

# Optional lower campaign-wide spending ceiling in USD. Once lowered, the ledger keeps it.
# CARL_CAMPAIGN_MAX_USD=10.00
