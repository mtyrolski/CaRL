{
  // which files/dirs to type-check at all
  "include": [
    "carl"
  ],

  // which files/dirs to completely ignore
  "exclude": [
    "build",
    "venv",
    "migrations",
    "**/__pycache__",
    "tests/**",
    "carl/environment/**",
    "legacy/**/*.py",
  ],

  // your other settings...
  "reportMissingImports": true,
  "pythonVersion": "3.11"
}
